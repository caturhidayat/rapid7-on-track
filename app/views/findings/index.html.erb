<h1 class="text-2xl font-bold mb-4">Findings</h1>

<div class="flex flex-wrap gap-3 mb-2 text-sm">
  <%= link_to "Open", root_path(severity: params[:severity], past_due: params[:past_due]), class: "px-3 py-1 rounded border #{'bg-gray-900 text-white' unless %w[closed all].include?(params[:status])}" %>
  <%= link_to "Closed", root_path(status: "closed", severity: params[:severity], past_due: params[:past_due]), class: "px-3 py-1 rounded border #{'bg-gray-900 text-white' if params[:status] == 'closed'}" %>
  <%= link_to "All", root_path(status: "all", severity: params[:severity], past_due: params[:past_due]), class: "px-3 py-1 rounded border #{'bg-gray-900 text-white' if params[:status] == 'all'}" %>
</div>

<div class="flex flex-wrap gap-3 mb-4 text-sm">
  <%= link_to "All severities", root_path(status: params[:status]), class: "px-3 py-1 rounded border #{'bg-gray-900 text-white' unless params[:severity]}" %>
  <% Vulnerability::SEVERITIES.each do |severity| %>
    <%= link_to severity, root_path(status: params[:status], severity: severity), class: "px-3 py-1 rounded border #{'bg-gray-900 text-white' if params[:severity] == severity}" %>
  <% end %>
  <%= link_to "Past due", root_path(status: params[:status], severity: params[:severity], past_due: true), class: "px-3 py-1 rounded border #{'bg-gray-900 text-white' if params[:past_due] == 'true'}" %>
</div>

<div class="overflow-x-auto">
  <table class="min-w-full text-sm bg-white shadow rounded">
    <thead class="bg-gray-100 text-left">
      <tr>
        <th class="px-4 py-2"><%= sortable_header "Asset", "asset" %></th>
        <th class="px-4 py-2"><%= sortable_header "Vulnerability", "vulnerability" %></th>
        <th class="px-4 py-2"><%= sortable_header "Severity", "severity" %></th>
        <th class="px-4 py-2"><%= sortable_header "CVSS", "cvss" %></th>
        <th class="px-4 py-2"><%= sortable_header "Due date", "due_date" %></th>
        <th class="px-4 py-2"><%= sortable_header "Past due", "past_due" %></th>
        <th class="px-4 py-2"><%= sortable_header "Status", "status" %></th>
      </tr>
    </thead>
    <tbody>
      <% @findings.each do |finding| %>
        <tr class="border-t">
          <td class="px-4 py-2"><%= link_to finding.asset.hostname, asset_path(finding.asset) %></td>
          <td class="px-4 py-2"><%= link_to finding.vulnerability.title, vulnerability_path(finding.vulnerability) %></td>
          <td class="px-4 py-2"><%= finding.vulnerability.severity %></td>
          <td class="px-4 py-2"><%= finding.vulnerability.cvss_score %></td>
          <td class="px-4 py-2"><%= finding.due_date&.to_date %></td>
          <td class="px-4 py-2"><%= finding.past_due ? "Yes" : "No" %></td>
          <td class="px-4 py-2"><%= render "findings/status_badge", finding: finding %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
