<h1 class="text-2xl font-bold mb-4">Assets</h1>

<div class="overflow-x-auto">
  <table class="min-w-full text-sm bg-white shadow rounded">
    <thead class="bg-gray-100 text-left">
      <tr>
        <th class="px-4 py-2"><%= sortable_header "Hostname", "hostname" %></th>
        <th class="px-4 py-2"><%= sortable_header "IP address", "ip_address" %></th>
        <th class="px-4 py-2"><%= sortable_header "Operating system", "operating_system" %></th>
        <th class="px-4 py-2"><%= sortable_header "Risk score", "risk_score" %></th>
        <th class="px-4 py-2"><%= sortable_header "Critical", "critical" %></th>
        <th class="px-4 py-2"><%= sortable_header "Severe", "severe" %></th>
        <th class="px-4 py-2"><%= sortable_header "Moderate", "moderate" %></th>
      </tr>
    </thead>
    <tbody>
      <% @assets.each do |asset| %>
        <tr class="border-t">
          <td class="px-4 py-2"><%= link_to asset.hostname, asset_path(asset) %></td>
          <td class="px-4 py-2"><%= asset.ip_address %></td>
          <td class="px-4 py-2"><%= asset.operating_system %></td>
          <td class="px-4 py-2"><%= asset.risk_score %></td>
          <td class="px-4 py-2"><%= asset.critical_vulnerability_count %></td>
          <td class="px-4 py-2"><%= asset.severe_vulnerability_count %></td>
          <td class="px-4 py-2"><%= asset.moderate_vulnerability_count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
