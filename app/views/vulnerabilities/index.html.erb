<h1 class="text-2xl font-bold mb-4">Vulnerabilities</h1>

<div class="overflow-x-auto">
  <table class="min-w-full text-sm bg-white shadow rounded">
    <thead class="bg-gray-100 text-left">
      <tr>
        <th class="px-4 py-2"><%= sortable_header "Title", "title" %></th>
        <th class="px-4 py-2"><%= sortable_header "Severity", "severity" %></th>
        <th class="px-4 py-2"><%= sortable_header "CVSS", "cvss" %></th>
        <th class="px-4 py-2"><%= sortable_header "Has exploits", "has_exploits" %></th>
        <th class="px-4 py-2"><%= sortable_header "Affected assets", "affected_assets" %></th>
      </tr>
    </thead>
    <tbody>
      <% @vulnerabilities.each do |vulnerability| %>
        <tr class="border-t">
          <td class="px-4 py-2"><%= link_to vulnerability.title, vulnerability_path(vulnerability) %></td>
          <td class="px-4 py-2"><%= vulnerability.severity %></td>
          <td class="px-4 py-2"><%= vulnerability.cvss_score %></td>
          <td class="px-4 py-2"><%= vulnerability.has_exploits ? "Yes" : "No" %></td>
          <td class="px-4 py-2"><%= vulnerability.findings_count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
