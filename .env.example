# Copy to .env (or set these in your host's real secret store) and fill in.
# .env itself is gitignored; this file is the template.

# Rollbar error tracking. Left unset, Rollbar reporting is disabled (see
# config/initializers/rollbar.rb) -- the app runs fine without it.
ROLLBAR_ACCESS_TOKEN=
# Defaults to Rails.env if unset.
ROLLBAR_ENVIRONMENT=
