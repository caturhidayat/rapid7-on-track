# Local dev: copy to .env and uncomment/fill in only what you actually need
# (dotenv loads it automatically in development/test -- see Gemfile).
# .env itself is gitignored.
#
# IMPORTANT: leave a line commented out (not "KEY=" with a blank value) when
# you don't need it. dotenv sets the var either way, and Rails treats an
# empty DATABASE_URL/CACHE_DATABASE_URL/etc. as "a URL was provided but it's
# blank" and raises "Database URL cannot be empty" -- even for plain local
# development, which doesn't use these at all (see config/database.yml).
#
# Production (Dokploy): dotenv is NOT loaded in production, so these get set
# in Dokploy's own Environment Variables panel instead of a .env file. This
# file just documents what every var is for, in one place, for either target.

# --- Database (production only; dev/test use local Postgres via config/database.yml) ---
# Rails 8's Solid Cache/Queue/Cable each use their own physical database
# (config/database.yml) -- provide a separate Postgres connection string for
# each. See CLAUDE.md ("Database" section) for why these are kept separate
# rather than consolidated into one.
# DATABASE_URL=
# CACHE_DATABASE_URL=
# QUEUE_DATABASE_URL=
# CABLE_DATABASE_URL=

# --- Rails ---
# Required in production; config/master.key is gitignored and won't exist on
# a fresh deploy, so this is how Rails decrypts config/credentials.yml.enc.
# Find the value in your local config/master.key.
# RAILS_MASTER_KEY=

# --- Rollbar error tracking ---
# Left unset, Rollbar reporting is disabled (see config/initializers/rollbar.rb)
# -- the app runs fine without it.
# ROLLBAR_ACCESS_TOKEN=
# Defaults to Rails.env if unset.
# ROLLBAR_ENVIRONMENT=
